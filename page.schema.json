{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "title": { "type": "string", "description": "The title of the page. Required." },
    "subtitle": { "type": "string", "description": "Subtitle of the page." },
    "description": { "type": "string", "description": "Description of the diagram. Required." },
    "summary": { "type": "string", "description": "" },
    "diagram": { "$ref": "diagram.schema.json", "description": "Diagram." }
  },
  "required": ["title", "description", "summary"],
  "additionalProperties": false
}
